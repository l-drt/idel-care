# API — Dev local uniquement (voir docs/ENV-URLS.md)
# Émulateur : localhost. iPhone sur le même WiFi : mets l'IP du PC (ipconfig → IPv4 Wi-Fi)
EXPO_PUBLIC_API_URL=http://localhost:3000/api
EXPO_PUBLIC_WS_URL=http://localhost:3000

# Production (Store) : cette URL est définie au build EAS (variables d'environnement production), pas ici.
# Ex. EXPO_PUBLIC_API_URL=https://api.idel-care.fr/api

# Mapbox (Phase 3)
# EXPO_PUBLIC_MAPBOX_TOKEN=pk.YOUR_MAPBOX_TOKEN

EXPO_PUBLIC_ENV=development
